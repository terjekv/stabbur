<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stabbur.server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/stabbur-server</string>
    <string>api</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>STABBUR_DATA_DIR</key>
    <string>/usr/local/var/lib/stabbur</string>
    <key>STABBUR_BIND</key>
    <string>127.0.0.1:8080</string>
  </dict>
  <key>UserName</key>
  <string>_stabbur</string>
  <key>GroupName</key>
  <string>staff</string>
  <key>WorkingDirectory</key>
  <string>/usr/local/var/lib/stabbur</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/stabbur-server/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/stabbur-server/stderr.log</string>
</dict>
</plist>
