<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.stabbur.worker</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/local/bin/stabbur-server</string>
    <string>worker</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>STABBUR_SERVER_URL</key>
    <string>https://stabbur.example.net</string>
    <key>STABBUR_WORKER_TOKEN_FILE</key>
    <string>/usr/local/var/lib/stabbur-worker/credential.json</string>
    <key>STABBUR_WORKER_DATA_DIR</key>
    <string>/usr/local/var/lib/stabbur-worker</string>
    <key>STABBUR_AUTOPKG_PROGRAM</key>
    <string>/Library/AutoPkg/autopkg</string>
  </dict>
  <key>UserName</key>
  <string>_stabbur_worker</string>
  <key>GroupName</key>
  <string>staff</string>
  <key>WorkingDirectory</key>
  <string>/usr/local/var/lib/stabbur-worker</string>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>Umask</key>
  <integer>63</integer>
  <key>StandardOutPath</key>
  <string>/usr/local/var/log/stabbur-worker/stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/usr/local/var/log/stabbur-worker/stderr.log</string>
</dict>
</plist>
